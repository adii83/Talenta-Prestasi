{
  "name": "talenta-prestasi-frontend",
  "private": true,
  "scripts": {
    "dev": "npx -y http-server@14.1.1 . -p 4173 -c-1 -o /apps/public-site/",
    "gateway": "node scripts/public-gateway.mjs",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloudflare-tunnel.ps1",
    "check:routes": "node scripts/validate-routes.mjs",
    "check:js": "node scripts/check-js.mjs",
    "test:runtime-config": "node scripts/audit-runtime-config.mjs",
    "check:theme": "node scripts/audit-theme-sync.mjs",
    "test:theme-browser": "node scripts/browser-theme-audit.mjs",
    "test:home-parity": "node scripts/browser-home-hero-parity.mjs",
    "test:hero-parity": "node scripts/browser-home-hero-parity.mjs",
    "test:download-relations": "node scripts/audit-download-relations.mjs",
    "test:download-layout": "node scripts/audit-download-editor-layout.mjs",
    "test:winner-relations": "node scripts/audit-winner-relations.mjs",
    "test:winner-layout": "node scripts/browser-winner-layout-audit.mjs",
    "test:archive-relations": "node scripts/audit-archive-relations.mjs",
    "test:archive-layout": "node scripts/audit-archive-layout.mjs",
    "test:faq-relations": "node scripts/audit-faq-relations.mjs",
    "test:admin-dialogs": "node scripts/audit-admin-dialogs.mjs",
    "test:category-events": "node scripts/audit-category-event-contracts.mjs",
    "test:event-publication": "node scripts/audit-event-publication.mjs && node scripts/audit-public-preview-scope.mjs",
    "test:event-period-ux": "node scripts/audit-admin-event-period-ux.mjs",
    "test:event-logo": "node scripts/audit-event-logo.mjs",
    "format": "npx -y prettier@3.9.6 . --write",
    "format:check": "npx -y prettier@3.9.6 . --check",
    "check": "npm run check:routes && npm run check:js && npm run check:theme && npm run test:event-publication && npm run format:check"
  }
}
