# Runtime
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# PostgreSQL (aplikasi belum membaca DATABASE_URL; petakan URL provider ke DB_* ini)
DB_HOST=DATABASE_HOST
DB_PORT=5432
DB_USERNAME=DATABASE_USER
DB_PASSWORD=CHANGE_WITH_DATABASE_PASSWORD
DB_DATABASE=DATABASE_NAME
DB_SSL=true
# Kosongkan bila CA publik sistem operasi sudah memverifikasi sertifikat provider.
# Isi path absolut bila provider memberikan CA khusus.
# DB_SSL_CA_PATH=/etc/talenta/certs/postgresql-ca.pem
# Migration production dijalankan manual. Jangan aktifkan pada proses aplikasi normal.
DB_MIGRATIONS_RUN=false

# Authentication
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h

# Browser dan domain
CORS_ORIGINS=https://admin.example.com
PUBLIC_BASE_DOMAIN=example.com

# Media persisten; direktori harus writable oleh user proses backend.
LOCAL_STORAGE_PATH=/srv/talenta/shared/uploads

# Hanya untuk development/local seed. Jangan isi atau jalankan seed:local di production.
# LOCAL_ADMIN_USERNAME=admin
# LOCAL_ADMIN_PASSWORD=CHANGE_WITH_STRONG_LOCAL_ADMIN_PASSWORD
